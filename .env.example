# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env ni .env.local al repositorio.

# Base de datos (PostgreSQL / Neon)
DATABASE_URL="postgresql://usuario:clave@host/base?sslmode=require"

# URL pública del sitio, usada en las back_urls de MercadoPago
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Clave del panel de administración. Si no se define, /admin y /api/admin
# rechazan el acceso y /api/seed no puede ejecutarse.
ADMIN_PASSWORD=""

# MercadoPago
MERCADOPAGO_ACCESS_TOKEN=""

# Correo saliente (SMTP). Sin estas variables el sitio responde 503 en los
# formularios en vez de perder la consulta en silencio.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Casilla que recibe las consultas del sitio (por defecto, la de contacto)
CONTACT_EMAIL=""
